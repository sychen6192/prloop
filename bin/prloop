#!/usr/bin/env bash
# Wrapper so prloop can be run from any directory.
set -euo pipefail
TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# prloop applies PRR_CA_CERTS itself (libs/tls.ts attaches it to the HTTP dispatcher), so
# this block is not what makes the tool's own requests work. It exists for the child
# processes — opencode, az, git — which have their own HTTP stacks and only read the
# environment. Precedence:
#   1. NODE_EXTRA_CA_CERTS already in the environment
#   2. PRR_CA_CERTS from .env (the place to put a corporate CA)
#   3. whatever bundle the rest of the toolchain already trusts. Node ships its own CA list
#      and ignores the system store, which is why az/curl/git can work on a TLS-intercepting
#      network while every Node tool fails on the same machine.
if [ -z "${NODE_EXTRA_CA_CERTS:-}" ]; then
  if [ -z "${PRR_CA_CERTS:-}" ] && [ -f "$TOOL_DIR/.env" ]; then
    # head -1: the in-process loader keeps the FIRST occurrence of a duplicated key, and
    # the wrapper must agree with it.
    PRR_CA_CERTS="$(sed -n 's/^[[:space:]]*PRR_CA_CERTS[[:space:]]*=[[:space:]]*//p' "$TOOL_DIR/.env" \
      | head -1 | sed 's/^["'\'']//; s/["'\'']$//')"
  fi
  # PRR_CA_CERTS may be a comma-separated list; NODE_EXTRA_CA_CERTS takes one file, so a
  # multi-file value is concatenated into a bundle first.
  ca_paths="$(printf '%s' "${PRR_CA_CERTS:-}" | tr ',' '\n' | sed 's/^ *//; s/ *$//')"
  if [ "$(printf '%s\n' "$ca_paths" | grep -c .)" -gt 1 ]; then
    bundle="$TOOL_DIR/runs/.ca-bundle.pem"
    mkdir -p "$TOOL_DIR/runs"
    : > "$bundle"
    ok=1
    while IFS= read -r p; do
      [ -z "$p" ] && continue
      if [ -r "$p" ]; then cat "$p" >> "$bundle"; else ok=0; fi
    done <<EOF
$ca_paths
EOF
    [ "$ok" = 1 ] && [ -s "$bundle" ] && export NODE_EXTRA_CA_CERTS="$bundle"
  fi
  if [ -z "${NODE_EXTRA_CA_CERTS:-}" ]; then
    for candidate in "${PRR_CA_CERTS:-}" "${REQUESTS_CA_BUNDLE:-}" "${SSL_CERT_FILE:-}" "${CURL_CA_BUNDLE:-}"; do
      if [ -n "$candidate" ] && [ -r "$candidate" ]; then
        export NODE_EXTRA_CA_CERTS="$candidate"
        break
      fi
    done
  fi
fi

# The repo's OWN tsx, not whatever the caller's directory happens to have. `npx tsx` resolves
# from the CURRENT working directory first, so running prloop from another project picked up
# that project's tsx — or, finding none, silently downloaded one over the network mid-run,
# which on an air-gapped or proxied box is a hang rather than an error.
TSX="$TOOL_DIR/node_modules/.bin/tsx"
if [ -x "$TSX" ]; then
  exec "$TSX" "$TOOL_DIR/loop.ts" "$@"
fi
# --no-install: use an already-installed tsx if there is one, never fetch. `npm ci --omit=dev`
# removes tsx (it is a devDependency), so this is the common failure on a CI agent.
if npx --no-install tsx --version >/dev/null 2>&1; then
  exec npx --no-install tsx "$TOOL_DIR/loop.ts" "$@"
fi
echo "prloop: tsx not found. Run 'npm ci' in $TOOL_DIR (dev dependencies included)." >&2
exit 1
