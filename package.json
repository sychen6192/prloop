{
  "name": "prloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts && tsx scripts/selftest-stream.ts && tsx scripts/selftest-runner.ts && tsx scripts/selftest-publish.ts && tsx scripts/selftest-ado.ts && tsx scripts/selftest-cli.ts && tsx scripts/selftest-docs.ts",
    "check": "tsc --noEmit && npm run selftest",
    "doctor": "tsx scripts/doctor.ts",
    "probe": "tsx scripts/probe.ts",
    "tlsfix": "tsx scripts/tlsfix.ts",
    "setup": "tsx scripts/setup.ts",
    "demo": "tsx scripts/demo.ts",
    "prloop": "tsx loop.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "undici": "^8.10.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sychen6192/prloop.git"
  }
}
