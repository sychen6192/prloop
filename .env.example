# prloop configuration. Copy to .env and fill in.
# Only auth and a model endpoint are required; everything else has a working default.
#
# .env never overrides a variable already set in your shell. Where that bites, a
# PRR_-prefixed alternative is listed below that always wins.
#
# `prloop --config` prints every setting below with the value it actually has and where
# that value came from (shell / .env / default) — start there when an edit here does nothing.

# ─── Azure DevOps auth (pick one) ─────────────────────────────────────────────
# (a) PAT with Code (Read & Write) + Work Items (Read) — the requirement axis reads the
#     linked work item, and a Code-only PAT fails there. In a pipeline, pass $(System.AccessToken).
# (b) Leave it empty and run `az login` instead.
PRR_ADO_PAT=

# ─── Model endpoint (OpenAI-compatible: LiteLLM proxy / vLLM / Ollama /v1) ────
PRR_LLM_BASE_URL=http://localhost:4000/v1
PRR_LLM_API_KEY=dummy
# Comma-separated. Two or more from *different model families* is what makes the
# consensus stage mean anything.
PRR_FINDER_MODELS=qwen3-coder

# ─── Finder ───────────────────────────────────────────────────────────────────
# Text appended to one finder's system prompt, as a JSON object model → text. Model
# families miss the coverage brief in opposite directions — Claude/GPT-class finders
# self-censor, Qwen-class ones over-report without naming the failing condition — and one
# shared prompt cannot lean against both:
#   PRR_FINDER_PROMPT_SUFFIX_BY_MODEL={"claude-sonnet":"Doubt is a confidence value, not a reason to omit the finding.","qwen3-coder":"Every finding names the input or condition under which the quoted line fails."}
# PRR_FINDER_PROMPT_SUFFIX_BY_MODEL=
# Seed for the per-finder file-order shuffle. Every finder sees the same files, each in its
# own order, so consensus cannot count shared position bias as agreement. Unset = a fresh
# seed per run, logged and saved in finder-outputs.json; set it to replay a run exactly.
# PRR_FINDER_SEED=

# ─── Adversarial verification ─────────────────────────────────────────────────
# Skeptics must be a DIFFERENT family from the finders: same-family verifiers share
# their blind spots and confirm exactly the errors that matter most.
# Leaving this empty means no verification runs — and with a single finder, nothing
# reaches an inline comment, because findings need corroboration to be published.
PRR_SKEPTIC_MODELS=
# The skeptic fans out over every anchored finding at once, so this is where a self-hosted
# endpoint gets swamped. This caps in-flight model calls across all stages. 0 = no cap.
PRR_LLM_CONCURRENCY=6
# EXTRA attempts on top of the first when a model call fails transiently (timeout / socket /
# 429 / 5xx): 1 = up to two calls, 0 = never retry. A 4xx is deterministic and never retried.
# One dead verifier call costs its finding an inline comment, so this is cheap insurance.
# Careful: PRR_ADO_MAX_RETRIES below counts TOTAL attempts, not extra ones.
# PRR_LLM_RETRIES=1

# ─── Corporate network ────────────────────────────────────────────────────────
# CA bundle to trust on a network that intercepts TLS. Comma-separated if the root and its
# intermediate came as separate files.
# Node ships its own CA list and ignores the system trust store, which is why az, curl
# and git can all work while every Node tool fails on the same machine.
#   Getting the file: browser → padlock → Certificate → Certification Path → select the
#   intermediate → export as Base64/PEM.  Or: npx tsx scripts/tlsfix.ts '<PR URL>'
PRR_CA_CERTS=
# Proxy. Node's fetch does not read HTTP(S)_PROXY by itself; prloop does. If your shell
# already exports them, leave these empty — the PRR_ names exist to override the shell.
PRR_HTTPS_PROXY=
# Same for plain http:// traffic; most networks use one proxy for both.
PRR_HTTP_PROXY=
# Internal hosts (a self-hosted model endpoint) must bypass the external proxy.
PRR_NO_PROXY=localhost,127.0.0.1
# Some proxies filter CONNECT by User-Agent. probe section 4b reports which strings pass.
PRR_USER_AGENT=

# ─── Static analysis (optional) ───────────────────────────────────────────────
# A checkout of the PR's source branch. Linters need files on disk; without this the
# static gate skips. In a pipeline this is the agent's own checkout.
# The tools EXECUTE that branch's code (eslint configs, Maven plugins, lint hooks), so
# they run with a secret-scrubbed environment: credential-shaped variables (*_PAT,
# *_TOKEN, *_SECRET, *_PASSWORD, *_API_KEY, *_ACCESS_KEY, *_PRIVATE_KEY,
# SYSTEM_ACCESSTOKEN, prloop's own PAT and LLM key) are dropped; PATH, JAVA_HOME,
# npm_config_*, proxies and CA paths pass through.
PRR_WORKDIR=
# Judges high-false-positive tools (bandit / PMD / SpotBugs / eslint). Leave empty and
# those findings are dropped rather than posted unjudged.
PRR_TRIAGE_MODEL=

# ─── Publishing ───────────────────────────────────────────────────────────────
# 1 = compute everything, publish nothing. Use it on the first run against a real PR.
PRR_DRY_RUN=
# Inline comment caps. The axes have separate budgets so code findings cannot crowd out
# "this requirement was never implemented".
# PRR_MAX_INLINE_COMMENTS=10
# PRR_MAX_INLINE_REQ_COMMENTS=3
# Below this severity a finding only appears in the summary: critical|high|medium|low
# PRR_MIN_INLINE_SEVERITY=medium
# 1 = also post a PR status (needs a branch policy to actually gate merges)
# PRR_POST_STATUS=

# ─── Noise control ────────────────────────────────────────────────────────────
# Finding categories this repo does not want reported, comma-separated. Dropped from the
# code axis before any verification budget is spent on them; the summary names the count.
# Valid: correctness,concurrency,security,reliability,data-integrity,performance,
#        maintainability,leftover-code
# PRR_EXCLUDE_CATEGORIES=
# Findings a human closed as wontFix/byDesign are remembered per repo (runs/<...>/
# dismissals.jsonl) and never re-posted. 0 turns the learning off.
# PRR_LEARN_FROM_DISMISSALS=1
# After this many dismissals in one category, the summary suggests excluding it.
# PRR_DISMISSAL_HINT_THRESHOLD=3

# ─── Runner ───────────────────────────────────────────────────────────────────
# openai (default) = direct HTTP. Supports engine-level guided decoding, which is what
#                    keeps weak models emitting valid JSON.
# opencode         = via the opencode CLI, reusing its provider config. It does NOT
#                    forward response_format, so schemas drop to prompt-level only.
# PRR_RUNNER=openai
# PRR_OPENCODE_AGENT=prloop-reviewer
# PRR_OPENCODE_BIN=opencode      # when the CLI is not on PATH
# PRR_OPENCODE_JSON=1            # 0 = drop --format json (for builds without JSONL events;
#                                # loses per-call tracing)
# PRR_AGENT_TIMEOUT_MS=900000    # wall clock for one opencode session

# ─── Rarely needed ────────────────────────────────────────────────────────────
# Every knob prloop reads is listed from here down, grouped as `--config` groups them.
# All of them have a working default; none of them needs setting to run a review.

# Azure DevOps
# PRR_AUTH_MODE=auto          # auto | pat | azcli
# PRR_AZ_BIN=az               # az CLI executable, when it is not on PATH
# PRR_ADO_API_VERSION=7.1     # on-prem: Server 2019→5.0, 2020→6.0, 2022→7.0
# PRR_ADO_BASE_URL=           # only when the API host differs from the browser host
# PRR_ADO_TIMEOUT_MS=60000    # per-request deadline for ADO REST calls
# PRR_ADO_MAX_RETRIES=3       # TOTAL attempts per ADO request (first try included), NOT extra
#                             # ones: 3 = one try + two retries, 1 = never retry. The opposite
#                             # sense to PRR_LLM_RETRIES; both names are published, so the
#                             # semantics are spelled out instead of renamed.
# PRR_ADO_CONCURRENCY=6       # parallel blob fetches during intake; ADO rate-limits more

# Model endpoint
# PRR_REQ_MODEL=              # defaults to the first finder model
# PRR_LLM_TIMEOUT_MS=900000   # deadline for one model call, first byte to last
# PRR_LLM_STALL_TIMEOUT_MS=120000 # abort a STREAM that goes silent this long. The deadline
#                             # above covers the whole call, so an engine that dies without
#                             # closing the socket costs the full 900s — then the retry
#                             # costs another 900s. Every chunk resets this timer, so a slow
#                             # generation is never cut, only a dead one. 0 = disabled.
# PRR_LLM_TEMPERATURE=0.2     # low on purpose: review is not a creative task. Set it to
#                             # "none" to omit the field entirely — newer Anthropic models
#                             # and OpenAI reasoning models reject temperature outright, and
#                             # prloop used to send one on every call with no way to stop it.
# PRR_LLM_TEMPERATURE_BY_MODEL= # per-model override, number or "none":
#                             #   PRR_LLM_TEMPERATURE_BY_MODEL={"claude-sonnet":"none"}
# PRR_LLM_MAX_TOKENS=8192     # thinking models need far more: chain of thought is billed to
#                             # this same budget. Measured on a self-hosted qwen3.6:27b, one
#                             # finder call spent 7.8k tokens with ~24k chars of reasoning —
#                             # 8192 leaves no headroom. Use 16384+ for a reasoning model.
# PRR_LLM_STRUCTURED=1        # 0 = don't send response_format (the schema is inlined into
#                             # the prompt instead — for backends whose schema dialect differs)
# PRR_LLM_STREAM=1            # stream completions (SSE). A buffered response is silent for
#                             # the whole generation, and any hop with an idle timeout
#                             # (nginx in front of vLLM, LiteLLM, a corporate gateway) kills
#                             # the long ones with a 504. Token accounting rides the final
#                             # chunk via stream_options.include_usage (vLLM / LiteLLM /
#                             # Ollama all send it). 0 = buffered single response.
# PRR_LLM_EXTRA_BODY=         # JSON object merged into every model request, for engine
#                             # knobs prloop has no flag for. prloop's own fields always win
#                             # on conflict. The motivating case — a Qwen3 finder burning
#                             # its whole token budget on chain of thought:
#                             #   PRR_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
#                             # Applies to EVERY call (skeptic included); per-model
#                             # behaviour belongs in the endpoint's per-alias config
#                             # (e.g. LiteLLM extra_body).
# PRR_LLM_EXTRA_BODY_BY_MODEL= # per-model override map; an entry REPLACES the global for
#                             # that model, {} = send none. Mixed fleet — thinking off
#                             # everywhere except the deep finder and the skeptic:
#                             #   PRR_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
#                             #   PRR_LLM_EXTRA_BODY_BY_MODEL={"coder":{},"architect":{}}
# PRR_REASONING=              # how much thinking to ask for: none | low | medium | high.
#                             # Unset (the default) sends nothing at all and leaves the
#                             # backend's own default alone. This is the portable way to say
#                             # it: the same intent is spelled reasoning_effort (OpenAI),
#                             # thinking.budget_tokens (Anthropic), chat_template_kwargs.
#                             # enable_thinking (Qwen) and think (Ollama), and sending the
#                             # wrong one is an HTTP 400 on every call of the run.
# PRR_REASONING_BY_MODEL=     # per-model level — the shape the global knob cannot express:
#                             #   PRR_REASONING_BY_MODEL={"qwen3-coder":"none","claude-sonnet":"medium"}
#                             # Precedence: PRR_LLM_EXTRA_BODY > this > PRR_REASONING.
# PRR_LLM_API_FLAVOR=auto     # which dialect the endpoint speaks, for the translation above:
#                             # auto | openai | anthropic | qwen | ollama. auto infers it per
#                             # model from the name (claude→anthropic, qwen→qwen, else
#                             # openai), which is right for a LiteLLM proxy fronting several
#                             # vendors; name it when your aliases are house names.
#                             # On an Anthropic model with thinking on, temperature is forced
#                             # to 1 — extended thinking rejects every other value.

# Finder
# PRR_RULES_DIR=              # defaults to the tool's own rules/. Put your team's coding
#                             # standards here as .md files with an applyTo glob; the
#                             # reviewed repo's own CONTRIBUTING/CODING_STANDARDS/CLAUDE.md
#                             # are additionally fetched and injected automatically.

# Diff / token budget
# PRR_MAX_DIFF_CHARS=240000
# PRR_HUNK_CONTEXT_BEFORE=6   # context lines kept before each hunk. Asymmetric on purpose:
# PRR_HUNK_CONTEXT_AFTER=3    # what precedes a change carries more meaning for review
# PRR_MAX_FILE_BYTES=2000000  # bigger files are diffed, never sent whole
# PRR_STRICT_COVERAGE=1       # 0 = files the finder never saw (over PRR_MAX_DIFF_CHARS, or
#                             # too large to fetch) no longer make the run incomplete (exit 3)

# Adversarial verification
# PRR_SKEPTIC_ROUNDS=1        # 3 gives a majority vote worth the name. Capped at the number
#                             # of distinct PRR_SKEPTIC_MODELS: re-sampling one model is not
#                             # a second opinion
# PRR_MAX_SKEPTIC_FINDINGS=30 # fan-out ceiling; worst findings verified first
# PRR_SKEPTIC_TIMEOUT_MS=180000  # tighter than the finder's: a skeptic reads ~25 lines
# PRR_SKEPTIC_MAX_TOKENS=4096   # output budget per verdict; raise if verdicts truncate
# PRR_SKEPTIC_CONTEXT_LINES=25  # source lines around the finding, on top of the whole hunk
#                             # it sits in. Small on purpose: a skeptic that needs the whole
#                             # file is guessing — it answers "insufficient-context" instead
# PRR_MIN_CONSENSUS_SOURCES=2 # independent finders needed to publish without a skeptic
# PRR_REQUIRE_CORROBORATION=1 # 0 = publish single-source unverified findings

# Requirement axis
# PRR_SKIP_REQUIREMENT=       # 1 = skip the requirement axis
# PRR_MAX_EXTRAS=5            # cap on reported out-of-scope changes (most significant first)

# Static analysis
# PRR_SKIP_STATIC=            # 1 = skip static analysis
# PRR_STATIC_TIMEOUT_MS=300000  # deadline for one linter invocation
# PRR_TRIAGE_CONTEXT_LINES=12 # source lines shown to the triage model
# PRR_MAX_TRIAGE_ITEMS=40     # a PR that trips 200 lint rules has a lint config problem

# Publishing
# PRR_STATUS_GENRE=prloop     # genre/name of the PR status posted with PRR_POST_STATUS=1
# PRR_STATUS_NAME=ai-review

# Diagnostics
# PRR_RUNS_KEEP=20            # iteration directories kept per PR under runs/, oldest deleted
#                             # first once a new one is created. 0 = keep every iteration.
#                             # One run stores the whole finder prompt and every model's raw
#                             # output, so an unattended box otherwise grows without bound.
#                             # Only pr-<id>/iter-* directories are ever removed — the
#                             # dismissals.jsonl learnings store is never touched.
# PRR_RUNS_MAX_AGE_DAYS=0     # also delete iteration directories older than this many days.
#                             # 0 = no age limit; independent of PRR_RUNS_KEEP (either rule
#                             # alone is enough to delete a directory).
# PRR_QUIET=
# PRR_RUNS_DIR=               # defaults to the tool's own runs/
# PRR_SHOW_CONFIG=            # 1 = print the settings table and exit, same as --config
